{
  "name": "dsh-ocean-theme",
  "version": "0.1.3",
  "description": "DSH 海洋主题：Markdown 琥珀单主色 + 正文等宽 + 全站琥珀强调色；界面两档跟随外观偏好——浅海（亮蓝画布 + 白玻璃面板）与深海（官方首页深蓝画布 + 海军蓝分层面板），用户气泡高对比月光蓝/淡azure蓝。纯 CSS，无设置。",
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "theme",
    "markdown",
    "ocean",
    "ocean-theme"
  ]
}
